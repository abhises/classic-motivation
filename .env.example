# Copy to .env.local and fill in what you use. Restart `npm run dev` after editing.

# Public URL of this app (used to build OAuth redirect URIs). Use your https tunnel URL for TikTok.
APP_URL=http://localhost:3000
# Optional: static https relay page for OAuth callbacks (see README "OAuth relay"). With this set, Instagram and
# TikTok use OAUTH_RELAY_URL/<platform>.html as their redirect URI and no tunnel is needed to connect accounts.
# OAUTH_RELAY_URL=https://you.github.io/your-repo/oauth
# Where make_short.py lives (default: ../shorts-maker)
# SHORTS_DIR=/home/you/Desktop/video-auto/shorts-maker

# Protect the studio with a password (browser login, any username) - set this before using a tunnel
# STUDIO_PASSWORD=

# --- YouTube (Google Cloud OAuth client, "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Instagram (Meta app -> Instagram API with Instagram login) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: if set, Instagram downloads the video from PUBLIC_BASE_URL/api/media/... instead of a direct upload
# PUBLIC_BASE_URL=https://your-tunnel.example.com
# IG_GRAPH_VERSION=v23.0

# --- TikTok (developers.tiktok.com: Login Kit + Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
